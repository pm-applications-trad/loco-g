# Release signing configuration template.
# Copy this file to `key.properties` (which is git-ignored) and fill in your
# own values. Generate a keystore with:
#
#   keytool -genkeypair -v -keystore android/app/locogames-release.jks \
#     -alias locogames -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to the android/app/ module directory.

storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=locogames
storeFile=locogames-release.jks
